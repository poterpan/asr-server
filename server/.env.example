# Copy to .env and fill in. Never commit .env.

# ---- Required for any non-localhost deployment ----
# Bearer token clients must send. Generate with: openssl rand -hex 32
# If unset, auth is disabled (logged as a startup WARNING when the server is
# bound to a non-loopback address).
FUNASR_API_KEY=

# ---- Optional ----

# Logging: DEBUG | INFO | WARNING | ERROR (default: INFO)
# FUNASR_LOG_LEVEL=INFO

# Where the server may persist artifacts (default: ./outputs).
# Currently only used as a writable scratch dir; safe to leave default.
# FUNASR_OUTPUT_DIR=outputs
